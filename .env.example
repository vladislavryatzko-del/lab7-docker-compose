# Скопируйте в .env:  cp .env.example .env   (файл .env не коммитится!)
# Значения ниже — учебные примеры, НЕ реальные секреты. Пароль замените на свой.

POSTGRES_USER=messenger
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=messenger

# Порт API на хосте (внутри контейнера всегда 8000)
API_PORT=8000

# Сколько последних сообщений группы хранить в Redis и сколько секунд живёт отметка online
LAST_CACHE_SIZE=50
ONLINE_TTL_SECONDS=60
